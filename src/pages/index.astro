---
const posts = [
	{
		date: "2026.09.06",
		tag: "随笔",
		title: "在小阳春里，开始写博客",
		excerpt: "记录一些正在发生的事，也给偶尔经过这里的人留一盏灯。",
	},
	{
		date: "2026.09.02",
		tag: "前端",
		title: "Astro：把页面交还给内容",
		excerpt: "轻巧、快速，还有足够的空间让个人表达自然生长。",
	},
	{
		date: "2026.08.27",
		tag: "生活",
		title: "夏末的风从窗边经过",
		excerpt: "咖啡、代码和一张还没写完的清单，今天也刚刚好。",
	},
];
---

<html lang="zh-CN">
	<head
		><meta charset="UTF-8" /><meta
			name="viewport"
			content="width=device-width"
		/><meta name="description" content="Linxi 的个人博客" /><link
			rel="icon"
			href="/favicon.svg"
		/><title>小春日和 · Linxi 的博客</title></head
	><body>
		<div class="page-shell">
			<aside class="sidebar">
				<div class="avatar">林</div><p class="eyebrow">
					KOHARU NOTE
				</p><h1>小春日和</h1><p class="intro">
					记录技术、生活，<br />以及那些微小但明亮的瞬间。
				</p><nav>
					<a class="active" href="/">首页 <span>01</span></a><a
						href="#posts">文章 <span>12</span></a
					><a href="#about">关于我 <span>→</span></a>
				</nav><div class="sidebar-footer">
					© 2026 Linxi <i></i> 保持好奇
				</div>
			</aside>
			<main class="content">
				<header>
					<span class="crumb">HOME / JOURNAL</span><button
						id="theme-toggle"
						aria-label="切换主题">☼</button>
				</header><section class="hero">
					<div>
						<p class="kicker">HELLO, WORLD</p><h2>
							你好，我是 Linxi <span>✦</span>
						</h2><p class="hero-copy">
							这里是我的数字花园。欢迎坐一会儿，<br
							/>看看最近在读什么、写什么、想些什么。
						</p><a class="button" href="#posts"
							>浏览文章 <span>↗</span></a>
					</div><div class="sun-card">
						<div class="sun"></div><div class="hill one"></div><div
							class="hill two"
						>
						</div><b>小春 · 01</b>
					</div>
				</section><section id="posts" class="posts">
					<div class="section-heading">
						<h3>最近文章</h3><a href="#posts">查看全部 →</a>
					</div>{
						posts.map((post) => (
							<article class="post">
								<>
									<div class="meta">
										<>
											<time>{post.date}</time>
											<span>{post.tag}</span>
										</>
									</div>
									<div>
										<>
											<h4>{post.title}</h4>
											<p>{post.excerpt}</p>
										</>
									</div>
									<strong>↗</strong>
								</>
							</article>
						))
					}
				</section><section id="about" class="quote">
					<p>
						愿每一次记录，<br />都成为未来回望时的温柔证据。
					</p><small>— linxi</small>
				</section>
			</main>
		</div><script>
			document
				.querySelector("#theme-toggle")
				?.addEventListener("click", () =>
					document.documentElement.classList.toggle("dark"),
				);
		</script></body>
</html>
<style>
	@import url("https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&family=Nunito:wght@500;700;800&display=swap");
	:global(*) {
		box-sizing: border-box;
	}
	:global(body) {
		margin: 0;
		font-family: "Noto Sans SC", sans-serif;
		color: #30384b;
		background: #f8f8fc;
	}
	:global(a) {
		color: inherit;
		text-decoration: none;
	}
	.page-shell {
		min-height: 100vh;
		display: grid;
		grid-template-columns: 280px 1fr;
		max-width: 1320px;
		margin: auto;
		background: #fff;
		box-shadow: 0 0 80px #cfd8ee55;
	}
	.sidebar {
		padding: 64px 38px 34px;
		display: flex;
		flex-direction: column;
		background: linear-gradient(160deg, #f3f6ff, #fff5fa);
		border-right: 1px solid #edf0f7;
	}
	.avatar {
		width: 58px;
		height: 58px;
		display: grid;
		place-items: center;
		border-radius: 20px;
		color: #fff;
		font: 800 24px Nunito;
		background: #7389e8;
		box-shadow: 8px 8px 0 #f4c9db;
	}
	.eyebrow,
	.kicker,
	.crumb {
		letter-spacing: 0.16em;
		font: 700 11px Nunito;
		color: #8b97b7;
	}
	h1 {
		margin: 17px 0 12px;
		font:
			800 32px Nunito,
			"Noto Sans SC";
		color: #30384b;
	}
	.intro {
		line-height: 1.9;
		color: #8993aa;
		font-size: 14px;
	}
	nav {
		margin-top: 68px;
		display: grid;
		gap: 11px;
	}
	nav a {
		padding: 14px 16px;
		border-radius: 12px;
		color: #8c96ad;
		font-size: 14px;
		display: flex;
		justify-content: space-between;
	}
	nav a.active {
		color: #566bd0;
		background: #e9edff;
		font-weight: 700;
	}
	nav span {
		font: 12px Nunito;
	}
	.sidebar-footer {
		margin-top: auto;
		color: #a9b1c1;
		font-size: 11px;
	}
	.sidebar-footer i {
		display: inline-block;
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: #f2a7c3;
		margin: 0 8px;
	}
	.content {
		padding: 34px clamp(28px, 7vw, 100px) 70px;
	}
	header {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	#theme-toggle {
		border: 0;
		background: #f2f4fa;
		border-radius: 50%;
		width: 38px;
		height: 38px;
		color: #717d9c;
		font-size: 18px;
		cursor: pointer;
	}
	.hero {
		margin-top: 84px;
		display: grid;
		grid-template-columns: 1fr 300px;
		gap: 50px;
		align-items: center;
	}
	h2 {
		margin: 12px 0 16px;
		font:
			800 clamp(31px, 4vw, 54px)/1.15 Nunito,
			"Noto Sans SC";
		color: #30384b;
	}
	h2 span {
		color: #f09cbb;
		font-size: 0.55em;
	}
	.hero-copy {
		color: #8b94a9;
		line-height: 1.9;
		font-size: 15px;
	}
	.button {
		display: inline-flex;
		gap: 18px;
		align-items: center;
		margin-top: 24px;
		padding: 13px 18px;
		border-radius: 10px;
		background: #7186e5;
		color: white;
		font-size: 13px;
		box-shadow: 0 8px 20px #7186e544;
	}
	.sun-card {
		height: 260px;
		position: relative;
		overflow: hidden;
		border-radius: 28px;
		background: linear-gradient(145deg, #dce5ff, #fce0eb);
	}
	.sun {
		position: absolute;
		width: 95px;
		height: 95px;
		border-radius: 50%;
		background: #ffd7a1;
		top: 44px;
		right: 55px;
		box-shadow: 0 0 0 18px #ffd7a133;
	}
	.hill {
		position: absolute;
		border-radius: 50% 50% 0 0;
		width: 140%;
		height: 150px;
		bottom: -90px;
		transform: rotate(-8deg);
	}
	.hill.one {
		left: -20%;
		background: #afc4ee;
	}
	.hill.two {
		left: 12%;
		bottom: -115px;
		background: #94acdf;
		transform: rotate(9deg);
	}
	.sun-card b {
		position: absolute;
		bottom: 22px;
		left: 24px;
		color: #fff;
		font: 700 12px Nunito;
	}
	.posts {
		margin-top: 92px;
	}
	.section-heading {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		border-bottom: 1px solid #edf0f5;
		padding-bottom: 14px;
	}
	h3 {
		margin: 0;
		font:
			800 22px Nunito,
			"Noto Sans SC";
	}
	.section-heading a {
		color: #9aa4b9;
		font-size: 12px;
	}
	.post {
		display: grid;
		grid-template-columns: 130px 1fr 28px;
		gap: 20px;
		align-items: start;
		padding: 25px 0;
		border-bottom: 1px solid #f0f1f5;
	}
	.meta {
		color: #a8b0c0;
		font: 12px Nunito;
		display: grid;
		gap: 8px;
	}
	.meta span {
		color: #ee9fba;
	}
	h4 {
		margin: 0 0 8px;
		font-size: 17px;
	}
	.post p {
		margin: 0;
		color: #929bad;
		font-size: 13px;
		line-height: 1.7;
	}
	.post strong {
		color: #aab5d9;
		font-size: 20px;
	}
	.quote {
		margin-top: 90px;
		padding: 35px 40px;
		border-radius: 18px;
		background: #f8f2f8;
		color: #6f7894;
	}
	.quote p {
		margin: 0;
		font:
			700 20px/1.7 Nunito,
			"Noto Sans SC";
	}
	.quote small {
		display: block;
		margin-top: 16px;
		color: #c0a1b1;
	}
	@media (max-width: 760px) {
		.page-shell {
			display: block;
		}
		.sidebar {
			padding: 30px 24px 22px;
		}
		nav {
			margin-top: 28px;
			grid-template-columns: repeat(3, 1fr);
			gap: 5px;
		}
		.sidebar-footer {
			display: none;
		}
		.content {
			padding: 25px 24px 55px;
		}
		.hero {
			margin-top: 54px;
			display: block;
		}
		.sun-card {
			margin-top: 35px;
			height: 190px;
		}
		.posts {
			margin-top: 62px;
		}
		.post {
			grid-template-columns: 90px 1fr;
			gap: 12px;
		}
		.post strong {
			display: none;
		}
	}
</style>
