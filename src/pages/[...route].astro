---
import BlogView from '../components/BlogView.astro';
import { views } from '../lib/posts';
export async function getStaticPaths() {
  return (await views()).filter((view) => !['home', 'about'].includes(view.kind)).map((view) => ({
    params: { route: view.path.slice(1, -1) },
    props: { view },
  }));
}
const { view } = Astro.props;
---
<BlogView view={view} />
