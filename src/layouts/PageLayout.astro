---
import BaseLayout from './BaseLayout.astro';
import { siteBase } from '../lib/urls';
interface Props { frontmatter: { title: string; description?: string } }
const { title, description } = Astro.props.frontmatter;
const rawPath = Astro.url.pathname.slice(siteBase.length);
const path = rawPath;
---
<BaseLayout title={title} description={description} path={path}>
  <div class="page-heading"><h1>{title}</h1></div>
  <article class="prose"><slot /></article>
</BaseLayout>
